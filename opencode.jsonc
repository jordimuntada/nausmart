{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "supabase": {
      "type": "local",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@supabase/mcp-server-supabase@latest", "--project-ref=ofqxvygsjneccemymtws"],
      "enabled": true,
      "env": {
        "SUPABASE_ACCESS_TOKEN": "${SUPABASE_ACCESS_TOKEN}",
        "SUPABASE_PROJECT_REF": "ofqxvygsjneccemymtws"
      }
    },
    "resend": {
      "type": "local",
      "command": ["npx", "-y", "resend-mcp"],
      "enabled": true,
      "env": {
        "RESEND_API_KEY": "${RESEND_API_KEY}"
      }
    },
    "apify": {
      "type": "remote",
      "url": "https://mcp.apify.com",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer ${APIFY_API_KEY}"
      }
    },
    "brave": {
      "type": "local",
      "command": ["npx", "-y", "@brave/brave-search-mcp-server"],
      "enabled": true,
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      }
    },
    "cala": {
      "type": "remote",
      "url": "https://api.cala.ai/mcp/",
      "enabled": true,
      "headers": {
        "X-API-KEY": "${CALA_API_KEY}"
      }
    }
  },
  "agent": {
    "customer-assurance": {
      "description": "Customer assurance expert. Handles inbound leads, contact form submissions, and community signups for RealBrave premium office spaces.",
      "mode": "subagent"
    }
  }
}